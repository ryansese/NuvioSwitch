<brls:Box
    width="auto"
    height="auto"
    axis="row"
    alignItems="center"
    focusable="true"
    cornerRadius="12"
    backgroundColor="@theme/nuvio/card"
    marginBottom="10"
    padding="10">

    <brls:Box
        width="160"
        height="90"
        marginRight="16">

        <brls:Image
            id="episode/thumbnail"
            width="160"
            height="90"
            cornerRadius="8"
            scalingType="fill"/>

        <!-- watch progress of an in-progress episode -->
        <brls:Box
            id="episode/bar"
            positionType="absolute"
            positionLeft="8"
            positionRight="8"
            positionBottom="6"
            height="4"
            cornerRadius="2"
            backgroundColor="#FFFFFF50"
            visibility="gone">

            <brls:Box
                id="episode/fill"
                width="0"
                height="4"
                cornerRadius="2"
                backgroundColor="#FFFFFF"/>
        </brls:Box>
    </brls:Box>

    <brls:Box
        width="auto"
        height="auto"
        grow="1"
        axis="column">

        <brls:Box
            axis="row"
            alignItems="center"
            marginBottom="4">

            <brls:Label
                id="episode/title"
                fontSize="18"
                singleLine="true"
                grow="1"/>

            <!-- watched -->
            <brls:Label
                id="episode/check"
                text="✔"
                fontSize="18"
                marginLeft="10"
                visibility="gone"/>
        </brls:Box>

        <brls:Label
            id="episode/date"
            fontSize="14"
            textColor="@theme/brls/text_disabled"
            marginBottom="4"/>

        <brls:Label
            id="episode/overview"
            fontSize="14"
            textColor="@theme/brls/text_disabled"/>
    </brls:Box>

</brls:Box>
