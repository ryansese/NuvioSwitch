<brls:Box
    width="auto"
    height="auto"
    grow="1"
    axis="column"
    justifyContent="center"
    alignItems="center">

    <!-- Focusable card so focus can move from the sidebar into the tab -->
    <brls:Box
        id="placeholder/card"
        width="560"
        height="auto"
        axis="column"
        alignItems="center"
        focusable="true"
        cornerRadius="12"
        backgroundColor="@theme/nuvio/card"
        paddingTop="40"
        paddingBottom="40"
        paddingLeft="40"
        paddingRight="40">

        <brls:Label
            id="placeholder/title"
            fontSize="36"
            horizontalAlign="center"
            marginBottom="16"/>

        <brls:Label
            id="placeholder/note"
            fontSize="20"
            horizontalAlign="center"
            textColor="@theme/brls/text_disabled"
            marginBottom="8"/>

        <brls:Label
            id="placeholder/coming_soon"
            text="@i18n/app/coming_soon"
            fontSize="16"
            horizontalAlign="center"
            textColor="@theme/brls/text_disabled"/>

        <brls:Label
            id="placeholder/version"
            visibility="gone"
            fontSize="16"
            horizontalAlign="center"
            marginTop="24"/>

    </brls:Box>

</brls:Box>
